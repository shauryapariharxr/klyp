# ---- Database (required) ----------------------------------------------------
# Free Postgres from https://neon.tech — copy the pooled connection string.
DATABASE_URL=

# ---- Cloudflare R2 (required for file uploads) ------------------------------
# Create a private bucket at https://dash.cloudflare.com -> R2, then generate
# an S3-compatible API token. Text-only transfers work without these.
R2_ACCOUNT_ID=        # the account ID used in the endpoint below
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=            # keep the bucket PRIVATE — downloads use signed URLs

# ---- Optional ---------------------------------------------------------------
# Shared secret required by /api/cleanup when triggered by Vercel Cron.
CRON_SECRET=
