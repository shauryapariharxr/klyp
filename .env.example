# ---- Database (required) ----------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Transaction
# pooler" (port 6543). Works with any Postgres provider.
DATABASE_URL=

# ---- Object storage (required for file uploads) ------------------------------
# Any S3-compatible provider works. The default stack is Supabase Storage —
# same project as the database, 1 GB free, and because transfers self-destruct
# after 15 minutes usage stays tiny.
#
# Supabase setup (2 minutes):
#   1. Dashboard -> Storage -> New bucket -> name it klyp, keep it PRIVATE
#   2. Storage -> Settings -> 'S3 connection info': copy the Endpoint and Region
#   3. Click 'Generate S3 access key' and paste the two values below
#
# IMPORTANT: keep S3_FORCE_PATH_STYLE=1 — browser uploads go to the presigned
# URL, and only path-style URLs get CORS headers from Supabase.
S3_ENDPOINT=            # e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=              # keep the bucket PRIVATE — downloads use signed URLs
S3_REGION=              # your Supabase project region, e.g. ap-southeast-2
S3_FORCE_PATH_STYLE=1

# Other S3-compatible providers (Backblaze B2 — 10 GB free, iDrive e2, Scaleway…)
# work with the same variables; point S3_ENDPOINT at their endpoint.
# CORS on the bucket only needs configuring for those providers (Supabase
# handles it automatically): node scripts/set-cors.js
#
# Cloudflare R2 also works — set S3_ENDPOINT to your R2 endpoint, or use the
# original variable set (endpoint is derived from the account ID):
#   R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET

# ---- Optional ----------------------------------------------------------------
# Shared secret required by /api/cleanup when triggered by Vercel Cron.
CRON_SECRET=

# Server-side secret mixed into PIN hashes. REQUIRED in production — generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_HASH_PEPPER=
