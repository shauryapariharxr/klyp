# ---- Database (required) ----------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler"
# (port 6543). Works with any Postgres provider.
DATABASE_URL=

# ---- Object storage (required for file uploads) ------------------------------
# Works with any S3-compatible provider. The easiest FREE option is
# Backblaze B2: https://www.backblaze.com/sign-up/cloud-storage
# (10 GB storage + 1 GB/day egress free, NO credit card required).
#
# 1. Create a PRIVATE bucket (e.g. "klyp")
# 2. App Keys -> "Add a New Application Key" (scope it to the bucket,
#    type: Read & Write). The keyID / applicationKey are the two values below.
# 3. Your endpoint is https://s3.<region>.backblazeb2.com — the region is
#    shown on the bucket's details page (e.g. us-west-004).
S3_ENDPOINT=            # e.g. https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=              # keep the bucket PRIVATE — downloads use signed URLs
S3_REGION=              # optional; some providers need it (B2: leave blank)
S3_FORCE_PATH_STYLE=    # set to 1 for Minio/Filebase-style path URLs

# Cloudflare R2 still works — either set S3_ENDPOINT to your R2 endpoint, or
# use the original variable set (endpoint is derived from the account ID):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Other free S3-compatible options: Filebase (5 GB), Scaleway (75 GB,
# card required), iDrive e2 (10 GB), Storj (paid-only since 2025).

# ---- Optional ---------------------------------------------------------------
# Shared secret required by /api/cleanup when triggered by Vercel Cron.
CRON_SECRET=

# Server-side secret mixed into PIN hashes. REQUIRED in production - generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_HASH_PEPPER=
