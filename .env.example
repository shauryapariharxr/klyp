# ---- Database (required) ----------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Transaction
# pooler" (port 6543). Works with any Postgres provider.
DATABASE_URL=

# ---- Object storage (required for file uploads) ------------------------------
# Any S3-compatible provider. Easiest FREE option: Backblaze B2
# (https://www.backblaze.com/sign-up/cloud-storage) — 10 GB + 1 GB/day egress
# free, no credit card.
#
#   1. Create a PRIVATE bucket (e.g. "klyp")
#   2. App Keys -> "Add a New Application Key" (scoped to the bucket,
#      Read & Write) — those are the two values below
#   3. Endpoint: https://s3.<region>.backblazeb2.com
S3_ENDPOINT=            # e.g. https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=              # keep the bucket PRIVATE — downloads use signed URLs
S3_REGION=              # optional; some providers need it (B2: leave blank)
S3_FORCE_PATH_STYLE=    # set to 1 for Minio/Filebase-style path URLs

# Cloudflare R2 also works — set S3_ENDPOINT to your R2 endpoint, or use the
# original variable set (endpoint is derived from the account ID):
#   R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET

# ---- Optional ----------------------------------------------------------------
# Shared secret required by /api/cleanup when triggered by Vercel Cron.
CRON_SECRET=

# Server-side secret mixed into PIN hashes. REQUIRED in production — generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_HASH_PEPPER=
